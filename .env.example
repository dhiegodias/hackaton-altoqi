# OPCIONAL: docker compose up --build -d funciona sem .env.
# Para personalizar, copie este arquivo para .env. Nunca versione .env.

# Acesso local e imagem (Compose).
RADAR_PORT=8787
RADAR_BIND=127.0.0.1
RADAR_IMAGE=radar-crm:local

# Geradas automaticamente no volume radar_secrets quando vazias.
# Em uma base existente, preserve estes valores e o volume de segredos.
# RADAR_ERASURE_KEY manual precisa de pelo menos 32 caracteres.
POSTGRES_PASSWORD=
RADAR_ERASURE_KEY=

# A demonstração usa contatos fictícios e dispensa credenciais externas.
DEMO_MODE=true
# Obrigatório quando DEMO_MODE=false; também protege a demo se preenchido.
RADAR_ACCESS_TOKEN=
# Ative apenas ao servir a aplicação com HTTPS.
COOKIE_SECURE=false

# Link temporário HTTPS, opcional: docker compose -f compose.tunnel.yaml up -d
# E-mails separados por vírgula ou domínio autorizado, por exemplo *@example.com.
# Obrigatório somente ao iniciar o túnel; acesso exige um código enviado por e-mail.
TUNNEL_ALLOWED_EMAILS=
# Container existente da aplicação. Confira com docker compose ps.
RADAR_TUNNEL_CONTAINER=radar-crm-app-1

# Pesquisa por IA opcional. Habilite as fontes também na interface.
# Modelo compatível com Responses, web_search e saída estruturada.
OPENAI_API_KEY=
OPENAI_MODEL=

# HubSpot opcional. Importação usa o token; envio exige habilitação e revisão.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_WRITE_ENABLED=false
# Nomes de propriedades de CONTATO já existentes no seu portal.
HUBSPOT_FIELD_MAP={"website":"website","role":"jobtitle"}

# 0 desativa a pesquisa periódica. 86400 = intervalo de um dia.
RADAR_SCAN_INTERVAL_SECONDS=0

# Limites por arquivo. O processamento confirma lotes de 100 contatos.
RADAR_IMPORT_MAX_ROWS=100000
RADAR_IMPORT_MAX_BYTES=104857600

# DATABASE_URL é montada pelo container a partir da credencial persistida.
# Não precisa ser configurada para usar o banco deste Compose.
